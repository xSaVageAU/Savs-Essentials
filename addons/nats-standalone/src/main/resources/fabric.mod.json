{
  "schemaVersion": 1,
  "id": "savs-essentials-nats-standalone",
  "version": "${version}",
  "name": "Sav's Essentials NATS Standalone",
  "description": "NATS KV Unified Storage & Messaging provider for Sav's Essentials.",
  "authors": [
    "xSaVageAU"
  ],
  "contact": {
    "homepage": "https://github.com/xSaVageAU/Savs-Essentials",
    "sources": "https://github.com/xSaVageAU/Savs-Essentials"
  },
  "license": "MIT",
  "icon": "assets/savs-essentials/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "savage.essentials.nats.standalone.NatsStandaloneAddon"
    ],
    "savs-essentials:storage": [
